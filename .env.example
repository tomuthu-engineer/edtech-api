# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME="EdTech LMS API"
APP_URL=http://localhost:4000
CLIENT_STUDENT_APP_URL=exp://localhost:19000
CLIENT_ADMIN_PORTAL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:19000

# ==============================================================================
# DATABASE (PostgreSQL via Prisma)
# ==============================================================================
# Port 5433 (not 5432) when using `docker compose up` for local Postgres —
# see docker-compose.yml. Avoids colliding with a PostgreSQL already
# installed natively on the host machine. Adjust if connecting elsewhere.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/edtech_lms?schema=public

# ==============================================================================
# JWT AUTH
# ==============================================================================
JWT_SECRET=change_me_super_secret_access_key
JWT_REFRESH_SECRET=change_me_super_secret_refresh_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d
JWT_ISSUER=edtech-lms
JWT_AUDIENCE=edtech-lms-clients

# ==============================================================================
# PASSWORD / OTP
# ==============================================================================
BCRYPT_SALT_ROUNDS=12
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# AWS S3 / CLOUDFRONT
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=edtech-lms-uploads
AWS_S3_SIGNED_URL_EXPIRES_IN=900
AWS_CLOUDFRONT_URL=

# ==============================================================================
# SMTP / EMAIL
# ==============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="EdTech LMS"
SMTP_FROM_EMAIL=no-reply@edtech-lms.com
SMTP_SECURE=false

# ==============================================================================
# LIVE CLASSES (LiveKit / Agora ready)
# ==============================================================================
LIVE_DEFAULT_PROVIDER=LIVEKIT
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info
